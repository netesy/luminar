// sample.lm

// Luminar Programming Language
// Key Features:
// - Subtyping and Row Polymorphism
// - Inline Assembly (Restricted)
// - Controlled Unsafe Operations

// ---------------------------------------------------
// Basic Syntax
// ---------------------------------------------------

// Arithmetic and Logical Operations
print(10 + 5 * 2);                  // Output: 20
print((10 > 5) and (5 < 2));        // false
print("Hello, " + "Luminar!");      // String concatenation

// ---------------------------------------------------
// Loops
// ---------------------------------------------------

// Range-based loop
for (i in 1..5) {
  print("Range iteration: {i}");
}

// List-based loop
var fruits: list<str> = ["Apple", "Banana", "Cherry"];
for (fruit in fruits) {
  print(fruit);
}

// List-based loop
var fruits: list = ["Apple", "Banana", "Cherry"];
for (fruit in fruits) {
  print(fruit);
}

// Dictionary iteration
var my_dict: dict = {"a": 1, "b": 2, "c": 3};
for (key, value in my_dict) {
    print("{key}: {value}");
}

var my_dict: dict<str, int> = {"a": 1, "b": 2, "c": 3};
for (key, value in my_dict) {
    print("{key}: {value}");
}

// While loop
var count: int = 0;
while (count < 3) {
  print("Count: {count}");
  count += 1;
}

// Nested loop
for (x in 1..3) {
  for (y in 1..2) {
    print("x: {x}, y: {y}");
  }
}

// ---------------------------------------------------
// I/O Operations
// ---------------------------------------------------

// Experimental: File handling
fn write_to_file(filename: str, content: str): void {
  var file = open(filename, "write");
  file.write(content);
  file.close();
}

fn read_from_file(filename: str): str? {
  var file = open(filename, "read");
  var content = file.read_all();
  file.close();
  return content;
}

// Usage example:
// write_to_file("example.txt", "Hello, File!");
// var content = read_from_file("example.txt");
// print(content.unwrap_or("File could not be read"));

// ---------------------------------------------------
// Modules
// ---------------------------------------------------

module MathUtils {
  fn add(a: int, b: int): int {
    return a + b;
  }

  fn subtract(a: int, b: int): int {
    return a - b;
  }

  fn factorial(n: int): int {
    if n <= 1 { return 1; }
    return n * factorial(n - 1);
  }
}

fn factorial(n: int) : int { if n <= 1 { return 1; } else { return n * factorial(n - 1); } }

// Using the module
import MathUtils;
print(MathUtils.add(5, 3));         // Output: 8
print(MathUtils.factorial(4));     // Output: 24

// ---------------------------------------------------
// Error Handling
// ---------------------------------------------------

fn divide(a: int, b: int): int? {
  if b == 0 {
    return error("Division by zero");
  }
  return a / b;
}

match divide(10, 0) {
  Some(result) => print("Result: {result}"),
  None => print("Error: Division by zero")
}

// ---------------------------------------------------
// Classes and Objects
// ---------------------------------------------------

class Vehicle {
  var name: str;
  var speed: int;

  Vehicle(name: str, speed: int) {
    self.name = name;
    self.speed = speed;
  }

  fn display() {
    print("Vehicle Name: {self.name}, Speed: {self.speed}");
  }
}

// Inheritance example
class Car : Vehicle {
  var model: str;

  Car(name: str, speed: int, model: str) : Vehicle(name, speed) {
    self.model = model;
  }

  fn display() {
    print("Car Model: {self.model}, Name: {self.name}, Speed: {self.speed}");
  }
}

var my_car = Car("Toyota", 120, "Corolla");
my_car.display();                  // Output: Car Model: Corolla, Name: Toyota, Speed: 120

// ---------------------------------------------------
// Parallel Processing
// ---------------------------------------------------

fn process_data() {
  var processing_results = parallel {
    tasks: [
      {
        var records = process_financial_records(stock_data);
        channels.financial.send(records);
      },
      {
        var analytics = generate_analytics(customer_segments);
        channels.analytics.send(analytics);
      },
      {
        var predictions = run_machine_learning_model(prediction_dataset);
        channels.ml.send(predictions);
      }
    ],
    cores: Auto,
    channels: {
      financial: ResultChannel<FinancialData>,
      analytics: ResultChannel<AnalyticsData>,
      ml: ResultChannel<MLPredictions>
    },
    error: {
      strategy: Continue,
      max_retries: 3,
      timeout: 30s
    }
  };

  // Accessing specific channel results
  var financial_results = processing_results.financial.collect();
  var analytics_results = processing_results.analytics.collect();
  var ml_predictions = processing_results.ml.collect();
}

// ---------------------------------------------------
// Concurrency
// ---------------------------------------------------

var shared_counter: Atomic<int> = Atomic(0);

fn increment_counter() {
  for (_ in 1..1000) {
    shared_counter.fetch_add(1);
  }
}

concurrent {
  increment_counter(),
  increment_counter()
}

print("Final counter value: {shared_counter.get()}");

// ---------------------------------------------------
// Real-Time Stream Processing
// ---------------------------------------------------

var stream_results = concurrent {
  worker: fn(event: StreamEvent) -> ProcessedEvent {
    event
      .validate()
      .normalize()
      .enrich_with_metadata();
  },
  input: kafka_stream.receive(),
  output: ResultChannel<ProcessedEvent>
};

// Process stream results
for event in stream_results {
  handle_processed_event(event);
}

// ---------------------------------------------------
// Pattern Matching
// ---------------------------------------------------

fn match_example(value: Any): void {
  match value {
    int => print("Integer: {value}"),
    str => print("String: {value}"),
    list<int> => print("List of integers: {value}"),
    dict<str, int> => print("Dictionary: {value}"),
    _ => print("Unknown type")
  }
}

match_example(42);
match_example("Hello, Luminar!");
match_example([1, 2, 3]);
match_example({ "a": 1, "b": 2 });


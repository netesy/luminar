// sample.lm
// Luminar Programming Language

// Unified Luminar Programming Language Syntax
// Combining Subtyping, Generics, Async, and Advanced Constructs

// ---------------------------------------------------
// Arithmetic and Logical Operations
// ---------------------------------------------------
print(1 + 2 + (3 * 4) - (10 / 5));        // Output: 10
print(!true or (5 > 3 and 2 < 4));        // Logical expressions
print("Hello" + " " + "World!");          // String concatenation

// ---------------------------------------------------
// Functions with Optional Parameters
// ---------------------------------------------------
fn greeting(name: str, date: str? = None): str {
    var message: str = "Hello, {name}";
    if (date) {
        message += ", today's date is {date.toDate()}";
    }
    return message;
}

print(greeting(name="John"));                // Output: Hello, John
print(greeting(name="John", date="2024-12-05")); // Output: Hello, John, today's date is Thursday, 5th December 2024

// ---------------------------------------------------
// Loops
// ---------------------------------------------------

// Range-based loop
for (i in 1..5) {
    print("Range iteration: {i}");
}

// C-style loop
for (var i = 0; i < 5; i++) {
    print("C-style iteration: {i}");
}

// List-based loop
var fruits: list<str> = ["Apple", "Banana", "Cherry"];
for (fruit in fruits) {
    print(fruit);
}

// Dictionary iteration
var my_dict: dict<str, int> = {"a": 1, "b": 2, "c": 3};
for (key, value in my_dict) {
    print("{key}: {value}");
}

// While loop
var counter: int = 0;
while (counter < 3) {
    print("Counter: {counter}");
    counter += 1;
}

// ---------------------------------------------------
// Error Handling
// ---------------------------------------------------
enum CustomError {
    Recoverable(str),
    Unrecoverable(str),
}
fn add(a:int, b:int){ return b+a;}
fn divide(a: int, b: int): int throws {
    if b == 0 {
        throw CustomError.Recoverable("Division by zero");
    }
    return a / b;
}

attempt {
    let result = divide(10, 0);
    print("Result: {result}");
} handle CustomError.Recoverable(msg) {
    print("Recoverable Error: {msg}");
} handle CustomError.Unrecoverable(msg) {
    print("Unrecoverable Error: {msg}");
}

// ---------------------------------------------------
// Classes and Objects
// ---------------------------------------------------
class Vehicle {
    var name: str;
    var speed: int;

    Vehicle(name: str, speed: int) {
        self.name = name;
        self.speed = speed;
    }

    fn display() {
        print("Vehicle: {self.name}, Speed: {self.speed}");
    }
}

class Car : Vehicle {
    var model: str;

    Car(name: str, speed: int, model: str) : Vehicle(name, speed) {
        self.model = model;
    }

    fn display() {
        print("Car Model: {self.model}, Name: {self.name}, Speed: {self.speed}");
    }
}

var my_car = Car("Toyota", 120, "Corolla");
my_car.display(); // Output: Car Model: Corolla, Name: Toyota, Speed: 120

// ---------------------------------------------------
// File I/O
// ---------------------------------------------------
var file = open("data.txt", "write");
file.write("Hello, Luminar!");
file.close();

// ---------------------------------------------------
// Generics
// ---------------------------------------------------
fn swap[T](a: T, b: T): void {
    var temp: T = a;
    a = b;
    b = temp;
}

// ---------------------------------------------------
// Concurrency and Parallelism
// ---------------------------------------------------

// Parallel processing
parallel {
    for (i in 1..5) {
        fn task(id: int) {
            print("Executing parallel task {id}");
            sleep(randint(1, 3)); // Simulate workload
            print("Parallel task {id} completed");
        }
        task(i);
    }
}

// Concurrent processing
concurrent {
    for (i in 1..3) {
        fn task(id: int) {
            print("Executing concurrent task {id}");
            sleep(randint(1, 3)); // Simulate workload
            print("Concurrent task {id} completed");
        }
        task(i);
    }
}

// ---------------------------------------------------
// Asynchronous Programming
// ---------------------------------------------------
async fn fetch_data(): str {
    sleep(2); // Simulate async operation
    return "Data fetched!";
}

var result = await fetch_data();
print("Async task result: {result}");

// ---------------------------------------------------
// Pattern Matching
// ---------------------------------------------------
fn match_example(value: Any): void {
    match value {
        int => print("Integer: {value}"),
        str => print("String: {value}"),
        list<int> => print("List of integers: {value}"),
        dict<str, int> => print("Dictionary: {value}"),
        _ => print("Unknown type"),
    }
}

match_example(42);         // Output: Integer: 42
match_example("Hello");    // Output: String: Hello
match_example([1, 2, 3]);  // Output: List of integers: [1, 2, 3]

// ---------------------------------------------------
// Imports and Modules
// ---------------------------------------------------
import math;

var radius: int = 5;
print("Circle area: {math.pi * radius * radius}");

